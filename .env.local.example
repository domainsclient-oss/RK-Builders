# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Add the same variables in your hosting provider's settings, because .env.local is not deployed.

# The "client_email" value from the service account's JSON key.
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# The "private_key" value from the JSON key, pasted as-is on one line inside the quotes (keep the \n sequences).
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# The long ID in the sheet's URL, between /d/ and /edit.
GOOGLE_SHEET_ID=your-sheet-id

# Optional: the tab (worksheet) name to add rows to. Defaults to Sheet1.
GOOGLE_SHEET_TAB=Sheet1
